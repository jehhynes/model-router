    {
      "name": "codex",
      "port": 8319,
      "passthrough": null,
      "model": {
        "upstream": "http://liberty-linux:8317",
        "apiKeyEnv": "CODEX_API_KEY",
        "paths": ["/v1/"]
      }
    }
  ]
}
